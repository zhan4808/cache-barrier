\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Measured cache-aware roofline for MLA reconstruction (H100, graph-timed). \textbf  {A}: CARM with measured HBM and L2 ceilings, per-point launch-floor caps, and the fitted INT4 dequant in-core ceiling (${\sim }30$\nobreakspace  {}TF); FP16 points (labeled by batch size) are filled when the working set fits $C_\text  {eff}$. \textbf  {B}: the capacity-gated bandwidth function $\mathrm  {BW}(\mathrm  {WS})$ --- effective serving bandwidth vs.\ working set, with the measured residency cliff at 32--40\nobreakspace  {}MB. \textbf  {C}: model validation, predicted vs.\ measured latency (dotted $= \pm 25\%$).\relax }}{14}{figure.caption.67}\protected@file@percent }
\newlabel{fig:carm}{{14}{14}{Measured cache-aware roofline for MLA reconstruction (H100, graph-timed). \textbf {A}: CARM with measured HBM and L2 ceilings, per-point launch-floor caps, and the fitted INT4 dequant in-core ceiling (${\sim }30$~TF); FP16 points (labeled by batch size) are filled when the working set fits $C_\text {eff}$. \textbf {B}: the capacity-gated bandwidth function $\mathrm {BW}(\mathrm {WS})$ --- effective serving bandwidth vs.\ working set, with the measured residency cliff at 32--40~MB. \textbf {C}: model validation, predicted vs.\ measured latency (dotted $= \pm 25\%$).\relax }{figure.caption.67}{}}
