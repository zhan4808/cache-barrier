\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces The L2 cache barrier. Roofline analysis predicts 2--3.9$\times $ INT4 speedup assuming HBM-bound operation. Measured performance shows 0.2--0.5$\times $: the INT4 kernel is \emph  {slower} than cuBLAS FP16. The 16\,MB reconstruction weight fits within the measured ${\sim }$36\,MB effective L2 capacity; in steady state ${\sim }$75\% is served from L2 at an effective 3.5--4.6\,TB/s, removing most of the HBM savings that motivate quantization (and the dequant-bound kernel forfeits the rest).\relax }}{10}{figure.caption.59}\protected@file@percent }
\newlabel{fig:l2barrier}{{9}{10}{The L2 cache barrier. Roofline analysis predicts 2--3.9$\times $ INT4 speedup assuming HBM-bound operation. Measured performance shows 0.2--0.5$\times $: the INT4 kernel is \emph {slower} than cuBLAS FP16. The 16\,MB reconstruction weight fits within the measured ${\sim }$36\,MB effective L2 capacity; in steady state ${\sim }$75\% is served from L2 at an effective 3.5--4.6\,TB/s, removing most of the HBM savings that motivate quantization (and the dequant-bound kernel forfeits the rest).\relax }{figure.caption.59}{}}
\@writefile{lot}{\contentsline {table}{\numberline {12}{\ignorespaces Measured INT4 kernel performance vs.\ cuBLAS FP16 \texttt  {torch.bmm}. ``FP16 loop'' = 128 individual \texttt  {torch.mm} calls.\relax }}{10}{table.caption.58}\protected@file@percent }
\newlabel{tab:int4_measured}{{12}{10}{Measured INT4 kernel performance vs.\ cuBLAS FP16 \texttt {torch.bmm}. ``FP16 loop'' = 128 individual \texttt {torch.mm} calls.\relax }{table.caption.58}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {9.5}The L2 Cache Barrier: Why Roofline Fails for Small-Matrix MLA Reconstruction}{10}{subsection.60}\protected@file@percent }
\newlabel{sec:l2barrier}{{9.5}{10}{The L2 Cache Barrier: Why Roofline Fails for Small-Matrix MLA Reconstruction}{subsection.60}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Cache-residency intervention at fixed MLA reconstruction shape (BS=1, normalized to FP16-warm). H100: eviction adds +4.8\nobreakspace  {}$\mu $s to FP16 (= full 16\nobreakspace  {}MB weight reload at HBM rate) and +3.9\nobreakspace  {}$\mu $s to INT4, of which ${\sim }2.6\nobreakspace  {}\mu $s is common-mode eviction overhead (expected INT4 reload: 1.3\nobreakspace  {}$\mu $s). The FP16 delta supports L2-residency dependence of the FP16 path; note that absolute deltas, not relative percentages, are the comparable quantity here since the two baselines differ ${\sim }2.6\times $.\relax }}{11}{figure.caption.61}\protected@file@percent }
\newlabel{fig:cache_intervention}{{10}{11}{Cache-residency intervention at fixed MLA reconstruction shape (BS=1, normalized to FP16-warm). H100: eviction adds +4.8~$\mu $s to FP16 (= full 16~MB weight reload at HBM rate) and +3.9~$\mu $s to INT4, of which ${\sim }2.6~\mu $s is common-mode eviction overhead (expected INT4 reload: 1.3~$\mu $s). The FP16 delta supports L2-residency dependence of the FP16 path; note that absolute deltas, not relative percentages, are the comparable quantity here since the two baselines differ ${\sim }2.6\times $.\relax }{figure.caption.61}{}}
\citation{carm}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Methodology validation (H100, bs=1, audit stack: torch\nobreakspace  {}2.7/triton\nobreakspace  {}3.3). \textbf  {Left}: per-launch event timing (repo method, dashed) vs.\ CUDA-graph timing (true kernel, solid). The ${\sim }15.5\nobreakspace  {}\mu $s launch/eventing floor --- not L2 serving --- produces the apparent flat region below 32\nobreakspace  {}MB; true kernel latency scales with weight size. \textbf  {Right}: effective compute throughput peaks at ${\sim }4.6$\nobreakspace  {}TFLOPS, 0.5\% of the 989\nobreakspace  {}TF peak, so neither kernel is compute-throughput-bound and INT4's high SM utilization is dequantization overhead, not useful FLOPs. Orange band: measured 32--40\nobreakspace  {}MB residency cliff; dashed line: nominal 50\nobreakspace  {}MB L2.\relax }}{12}{figure.caption.62}\protected@file@percent }
\newlabel{fig:val_latency}{{11}{12}{Methodology validation (H100, bs=1, audit stack: torch~2.7/triton~3.3). \textbf {Left}: per-launch event timing (repo method, dashed) vs.\ CUDA-graph timing (true kernel, solid). The ${\sim }15.5~\mu $s launch/eventing floor --- not L2 serving --- produces the apparent flat region below 32~MB; true kernel latency scales with weight size. \textbf {Right}: effective compute throughput peaks at ${\sim }4.6$~TFLOPS, 0.5\% of the 989~TF peak, so neither kernel is compute-throughput-bound and INT4's high SM utilization is dequantization overhead, not useful FLOPs. Orange band: measured 32--40~MB residency cliff; dashed line: nominal 50~MB L2.\relax }{figure.caption.62}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Direct evidence for (partial) L2 serving (H100, bs=1, audit stack). \textbf  {Left}: effective serving bandwidth (logical bytes / true graph-timed kernel time). Below the residency cliff FP16 exceeds the 3.35\nobreakspace  {}TB/s HBM peak --- only possible if L2-served --- at an effective 3.5--4.4\nobreakspace  {}TB/s (far below the ${\sim }12$\nobreakspace  {}TB/s aggregate L2 figure), and settles to ${\sim }2.5$--$2.7$\nobreakspace  {}TB/s (HBM regime) above it. \textbf  {Right}: NCU \texttt  {dram\_\_bytes\_read} per launch. Warm-loop counters (\texttt  {--cache-control none}, green) show DRAM re-reads collapsing far below the full weight size at 16--32\nobreakspace  {}MB and snapping to ${\sim }100\%$ at $\geq $40\nobreakspace  {}MB; cache-flushed replay (\texttt  {--cache-control all}, grey) re-reads the full weight at every size and is therefore blind to residency. The cliff is at 32--40\nobreakspace  {}MB (effective capacity ${\sim }36$\nobreakspace  {}MB), not the nominal 50\nobreakspace  {}MB.\relax }}{12}{figure.caption.63}\protected@file@percent }
\newlabel{fig:val_bw}{{12}{12}{Direct evidence for (partial) L2 serving (H100, bs=1, audit stack). \textbf {Left}: effective serving bandwidth (logical bytes / true graph-timed kernel time). Below the residency cliff FP16 exceeds the 3.35~TB/s HBM peak --- only possible if L2-served --- at an effective 3.5--4.4~TB/s (far below the ${\sim }12$~TB/s aggregate L2 figure), and settles to ${\sim }2.5$--$2.7$~TB/s (HBM regime) above it. \textbf {Right}: NCU \texttt {dram\_\_bytes\_read} per launch. Warm-loop counters (\texttt {--cache-control none}, green) show DRAM re-reads collapsing far below the full weight size at 16--32~MB and snapping to ${\sim }100\%$ at $\geq $40~MB; cache-flushed replay (\texttt {--cache-control all}, grey) re-reads the full weight at every size and is therefore blind to residency. The cliff is at 32--40~MB (effective capacity ${\sim }36$~MB), not the nominal 50~MB.\relax }{figure.caption.63}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {9.6}A Measured Cache-Aware Roofline}{12}{subsection.65}\protected@file@percent }
\newlabel{sec:carm}{{9.6}{12}{A Measured Cache-Aware Roofline}{subsection.65}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces INT4/FP16 ratio and causal decomposition (H100, bs=1, audit stack). \textbf  {Left}: INT4/FP16 time ratio vs.\ weight size, event-timed (grey, launch-overhead-inflated) and graph-timed (purple, true kernel). The knee sits at the measured 32--40\nobreakspace  {}MB effective capacity, not the nominal 50\nobreakspace  {}MB; the graph-timed kernel ratio (1.9$\times $ near the cliff $\to $ 1.0--1.1$\times $ at 128\nobreakspace  {}MB) matches the main-stack result, while event-timed magnitudes are stack-dependent (a robustness caveat we flag in the Limitations). \textbf  {Right}: weight-rotation intervention at fixed 16\nobreakspace  {}MB shape. Forcing FP16 out of L2 (6 weight copies) raises FP16 from 4.8 to 8.3\nobreakspace  {}$\mu $s, but INT4 (9.1--9.3\nobreakspace  {}$\mu $s, cache-insensitive) is \emph  {still} 1.12$\times $ slower than evicted FP16 and runs 2.7$\times $ above its ${\sim }3.4\nobreakspace  {}\mu $s memory entitlement: L2 residency is necessary but not sufficient to explain INT4's failure; dequantization compute accounts for the rest.\relax }}{13}{figure.caption.64}\protected@file@percent }
\newlabel{fig:val_ratio}{{13}{13}{INT4/FP16 ratio and causal decomposition (H100, bs=1, audit stack). \textbf {Left}: INT4/FP16 time ratio vs.\ weight size, event-timed (grey, launch-overhead-inflated) and graph-timed (purple, true kernel). The knee sits at the measured 32--40~MB effective capacity, not the nominal 50~MB; the graph-timed kernel ratio (1.9$\times $ near the cliff $\to $ 1.0--1.1$\times $ at 128~MB) matches the main-stack result, while event-timed magnitudes are stack-dependent (a robustness caveat we flag in the Limitations). \textbf {Right}: weight-rotation intervention at fixed 16~MB shape. Forcing FP16 out of L2 (6 weight copies) raises FP16 from 4.8 to 8.3~$\mu $s, but INT4 (9.1--9.3~$\mu $s, cache-insensitive) is \emph {still} 1.12$\times $ slower than evicted FP16 and runs 2.7$\times $ above its ${\sim }3.4~\mu $s memory entitlement: L2 residency is necessary but not sufficient to explain INT4's failure; dequantization compute accounts for the rest.\relax }{figure.caption.64}{}}
\newlabel{eq:carm}{{2}{13}{A Measured Cache-Aware Roofline}{equation.66}{}}
