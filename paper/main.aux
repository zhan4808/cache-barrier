\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {The capacity gate.} Speedup over tuned cuBLAS bf16 vs.\ normalized weight working set $W/C_\text  {eff}$, one line per token count $T$; 77 cells, clock-locked, CUDA-graph timed (10 launches/graph, median of 30 replays), per-cell mini-autotuned. At decode-scale $T\!\leq \!32$ the sign flips between $W$=32 and 40\nobreakspace  {}MB --- bracketing the measured $C_\text  {eff}$=36\nobreakspace  {}MB. W8A8 (left; INT8 MMA, dynamic act-quant inside the timed region, no in-core dequant) reaches 1.2--1.46$\times $ in the far field; W4A16 (right) flips at the same boundary but caps at parity, bound by its in-core dequant ceiling. At $T\!\geq \!64$ both lose everywhere: the compute-bound regime that produces MARLIN's reported batch-64 collapse. Data: \texttt  {profiling/gate/results\_capacity\_gate.json}.\relax }}{4}{figure.caption.13}\protected@file@percent }
\newlabel{fig:gate}{{1}{4}{\textbf {The capacity gate.} Speedup over tuned cuBLAS bf16 vs.\ normalized weight working set $W/C_\text {eff}$, one line per token count $T$; 77 cells, clock-locked, CUDA-graph timed (10 launches/graph, median of 30 replays), per-cell mini-autotuned. At decode-scale $T\!\leq \!32$ the sign flips between $W$=32 and 40~MB --- bracketing the measured $C_\text {eff}$=36~MB. W8A8 (left; INT8 MMA, dynamic act-quant inside the timed region, no in-core dequant) reaches 1.2--1.46$\times $ in the far field; W4A16 (right) flips at the same boundary but caps at parity, bound by its in-core dequant ceiling. At $T\!\geq \!64$ both lose everywhere: the compute-bound regime that produces MARLIN's reported batch-64 collapse. Data: \texttt {profiling/gate/results\_capacity\_gate.json}.\relax }{figure.caption.13}{}}
